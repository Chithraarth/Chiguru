# Copy this to .env (docker compose picks it up automatically) or paste these
# into Portainer's Stack "Environment variables" editor when creating the
# stack — do not commit a real .env file.

# Your Docker Hub username — images are built/pushed locally as
# <user>/chiguru-api-server and <user>/chiguru-nginx, then pulled here.
DOCKERHUB_USER=

# Your domain, pointed at this EC2 instance's IP via an A record.
DOMAIN=example.com

# Password for the containerized Postgres (pick your own strong value —
# this is NOT a real secret shipped anywhere, just something you invent).
POSTGRES_PASSWORD=

# Firebase (Console → Project settings → Service accounts → Generate new
# private key, for the backend; Console → Project settings → General → Your
# apps for the frontend values below).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Frontend build-time values — safe to be public, same as Firebase's own docs.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Stripe (dashboard.stripe.com → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from Stripe Dashboard → Product catalog, one per plan/add-on.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_MANAGER_SEAT=
# Where Stripe Checkout redirects back to after payment.
PUBLIC_APP_URL=https://example.com

# OpenAI (from platform.openai.com/api-keys)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
